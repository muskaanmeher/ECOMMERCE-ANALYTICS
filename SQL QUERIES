#Average delivery days for pet_shop
SELECT pcn.product_category_name_english as Product, ROUND(AVG(DATEDIFF(o.order_delivered_customer_date,o.order_purchase_timestamp)),2) AS AVG_DELIVERY_DAYS from 
product_category_name as pcn left join products_dataset pr on pcn.product_category_name=pr.product_category_name 
 left join order_items as i on pr.product_id=i.product_id
 left join orders_dataset as o on  i.order_id=o.order_id 
 where  pcn.product_category_name="PET_SHOP" group by pcn.product_category_name_english;
 
 #WEEKDAY VS WEEKEND PAYMENT STATISTICS
 SELECT
CONCAT("R$ ",ROUND(SUM( CASE WHEN DAYOFWEEK(orders.order_purchase_timestamp) IN (1, 7) THEN pay.payment_value ELSE 0 END) / 1000000, 2), 'M') AS WEEKEND_PAYMENTS,
CONCAT("R$ ",ROUND(SUM(CASE WHEN DAYOFWEEK(orders.order_purchase_timestamp) NOT IN (1, 7) THEN pay.payment_value ELSE 0 END) / 1000000, 2), 'M') AS WEEKDAY_PAYMENTS
FROM payments_dataset AS pay
LEFT JOIN orders_dataset AS orders
ON pay.order_id = orders.order_id;

select 
WEEKEND.payment_type,WEEKEND.TOTAL_PAYMENTS_ON_WEEKENDS,WEEKKDAY.TOTAL_PAYMENTS_ON_WEEKDAYS,
CASE
WHEN WEEKEND.TOTAL_PAYMENTS_ON_WEEKENDS > WEEKKDAY.TOTAL_PAYMENTS_ON_WEEKDAYS THEN 'WeekEND Payments are Higher'
WHEN WEEKEND.TOTAL_PAYMENTS_ON_WEEKENDS < WEEKKDAY.TOTAL_PAYMENTS_ON_WEEKDAYS THEN 'WeekDAY Payments are Higher'
ELSE 'Both are Equal'
END AS PAYMENT_COMPARISON
from 
(select pay.payment_type,CONCAT(ROUND(SUM(PAY.PAYMENT_VALUE ) / 10000, 2), 'M')  as TOTAL_PAYMENTS_ON_WEEKENDS from
 payments_dataset as pay left join orders_dataset as orders on pay.order_id=orders.order_id 
 where DAYOFWEEK(orders.order_purchase_timestamp) IN (1, 7) group by pay.payment_type ) as weekend
inner join
(select pay.payment_type, CONCAT(ROUND(SUM(PAY.PAYMENT_VALUE ) / 10000, 2), 'M') AS  TOTAL_PAYMENTS_ON_WEEKDAYS from payments_dataset as pay left join orders_dataset as orders on pay.order_id=orders.order_id 
 where DAYOFWEEK(orders.order_purchase_timestamp) NOT IN (1, 7) group by pay.payment_type ) as weekkday
 on weekend.payment_type=weekkday.payment_type ORDER BY WEEKEND.TOTAL_PAYMENTS_ON_WEEKENDS,WEEKKDAY.TOTAL_PAYMENTS_ON_WEEKDAYS DESC;

#Relationship between shipping days (order_delivered_customer_date - order_purchase_timestamp) Vs review scores.
select  ROUND(avg(DATEDIFF(orders.order_delivered_customer_date,orders.order_purchase_timestamp)), 2) AS SHIPPING_DAYS,reviews.review_score  from 
orders_dataset as orders left join order_review_dataset as reviews on orders.order_id=reviews.order_id WHERE orders.order_delivered_customer_date IS NOT NULL AND reviews.review_score IS NOT NULL
group by reviews.review_score order by SHIPPING_DAYS;

#TOTAL REVENUE OVER TIME
 SELECT YEAR(ORDERS.order_purchase_timestamp) AS YEAR_DATE,CONCAT("R$",ROUND(SUM(ITEMS.PRICE)/1000000,2),"M")  AS REVENUE FROM 
 order_items AS ITEMS INNER JOIN orders_dataset AS ORDERS ON ITEMS.ORDER_ID=ORDERS.order_id
 GROUP BY YEAR_DATE ORDER BY revenue;
 
 #TOP 10 CATEGORIES BY REVENUE
SELECT pcn.product_category_name_english,concat(round(sum(items.price)/1000000,4),"M") as revenue FROM  product_category_name AS PCN LEFT JOIN products_dataset as products on pcn.product_category_name=products.product_category_name
left join order_items as items on products.product_id=items.product_id  group by pcn.product_category_name_english order by revenue desc limit 10;

 #SALES BY PAYMENT METHOD
 SELECT PAYMENTS.payment_type AS PAYMENT_METHOD,
    ROUND(
        SUM(ITEMS.PRICE) * 100/
        SUM(SUM(ITEMS.PRICE)) OVER(), 2
    ) AS percentage
 FROM payments_dataset AS PAYMENTS LEFT JOIN order_items AS ITEMS ON PAYMENTS.order_id=ITEMS.order_id WHERE PAYMENTS.payment_type IS NOT NULL
 GROUP BY PAYMENT_METHOD order by percentage desc ;
 
 

 
 
